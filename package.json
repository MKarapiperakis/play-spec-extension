{
  "name": "playspec",
  "displayName": "PlaySpec – Generate Playwright Tests from OpenAPI/Swagger",
  "description": "Generate Playwright API tests from an OpenAPI/Swagger spec (file or URL), directly inside your workspace — endpoints grouped by tag, sample data, and auth wired up automatically.",
  "version": "0.1.0",
  "publisher": "playspec",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MKarapiperakis/play-spec-extension.git"
  },
  "bugs": {
    "url": "https://github.com/MKarapiperakis/play-spec-extension/issues"
  },
  "homepage": "https://github.com/MKarapiperakis/play-spec-extension#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "playwright",
    "openapi",
    "swagger",
    "api testing",
    "generate tests",
    "test generator",
    "rest api",
    "e2e testing",
    "api automation",
    "swagger to playwright"
  ],
  "galleryBanner": {
    "color": "#0B1021",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "playspec.generateFromFile",
        "title": "PlaySpec: Generate Playwright Tests from Spec File...",
        "category": "PlaySpec"
      },
      {
        "command": "playspec.generateFromUrl",
        "title": "PlaySpec: Generate Playwright Tests from Spec URL...",
        "category": "PlaySpec"
      },
      {
        "command": "playspec.generateFromExplorer",
        "title": "PlaySpec: Generate Playwright Tests from This Spec",
        "category": "PlaySpec",
        "icon": "$(play)"
      },
      {
        "command": "playspec.validateFromFile",
        "title": "PlaySpec: Validate Spec File...",
        "category": "PlaySpec"
      },
      {
        "command": "playspec.validateFromUrl",
        "title": "PlaySpec: Validate Spec URL...",
        "category": "PlaySpec"
      },
      {
        "command": "playspec.validateFromExplorer",
        "title": "PlaySpec: Validate This Spec",
        "category": "PlaySpec",
        "icon": "$(check)"
      },
      {
        "command": "playspec.refreshSpecExplorer",
        "title": "PlaySpec: Refresh Spec Explorer",
        "category": "PlaySpec",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "playspec",
          "title": "PlaySpec",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "playspec": [
        {
          "id": "playspec.specExplorer",
          "name": "PlaySpec"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "playspec.generateFromExplorer",
          "when": "resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml",
          "group": "playspec"
        },
        {
          "command": "playspec.validateFromExplorer",
          "when": "resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml",
          "group": "playspec"
        }
      ],
      "editor/title": [
        {
          "command": "playspec.generateFromExplorer",
          "when": "resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml",
          "group": "navigation"
        },
        {
          "command": "playspec.validateFromExplorer",
          "when": "resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "playspec.refreshSpecExplorer",
          "when": "view == playspec.specExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "playspec.generateFromExplorer",
          "when": "view == playspec.specExplorer && viewItem == playspec.specFile",
          "group": "inline@1"
        },
        {
          "command": "playspec.validateFromExplorer",
          "when": "view == playspec.specExplorer && viewItem == playspec.specFile",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "playspec.generateFromExplorer",
          "when": "false"
        },
        {
          "command": "playspec.validateFromExplorer",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "PlaySpec",
      "properties": {
        "playspec.outputFolderName": {
          "type": "string",
          "default": "playwright-tests",
          "description": "Name of the folder created at the workspace root to hold the generated Playwright test project."
        },
        "playspec.skipResponseValidation": {
          "type": "boolean",
          "default": false,
          "description": "Default value written to the generated project's .env.sample for SKIP_RESPONSE_VALIDATION."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "js-yaml": "^4.1.0"
  }
}
